<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shiftlock.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shiftlock.App"
    Title="shiftlock">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 文面はここに書かない（コードから Core の文面を入れる）．色は標準のテーマ資源だけを使う（明るい配色・暗い配色の両方で読めるように）． -->
    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="shiftlock">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 左のメニューでページを切り替える（ページは作ったまま置き，出す・隠すだけ）．項目の名前はコードから入れる -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="132"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavNow" Icon="Home" />
                <NavigationViewItem x:Name="NavSchedule" Icon="Calendar" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 設定が無い・読めないとき（どのページでも出す） -->
                <InfoBar
                    x:Name="ConfigError"
                    Margin="20,12,20,0"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning" />

        <ScrollViewer x:Name="NowView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,12,20,20" Spacing="12">

                <!-- いまの状態: 現在時刻・フェーズ・残り時間 -->
                <StackPanel x:Name="StatusPanel" Spacing="2">
                    <TextBlock
                        x:Name="NowText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="PhaseText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CountdownText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 次の乗務（見出し・就寝の時刻・出発・出庫・記録） -->
                <Border x:Name="ShiftCard" Style="{StaticResource Card}">
                    <StackPanel x:Name="ShiftLines" Spacing="4" />
                </Border>

                <!-- 記録のボタン．4 つとも同じ見た目（どれかを勧めない） -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NeruButton" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnNeru" />
                    <Button x:Name="OkitaButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnOkita" />
                    <Button x:Name="ShuppatsuButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnShuppatsu" />
                    <Button x:Name="KitakuButton" Grid.Column="3" HorizontalAlignment="Stretch" Click="OnKitaku" />
                </Grid>

                <!-- 直前に押したボタンの返事と「取り消す」 -->
                <Grid x:Name="ResultRow" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ResultText"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="UndoButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="OnUndo"
                        Visibility="Collapsed" />
                </Grid>

                <!-- 予定（今日から 14 日．7 日ずつ 2 行） -->
                <Border x:Name="ScheduleCard" Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ScheduleTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid x:Name="ScheduleGrid" ColumnSpacing="4" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

                <!-- 予定（28 日）と例外日 -->
                <local:SchedulePage x:Name="SchedulePage" Grid.Row="1" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
