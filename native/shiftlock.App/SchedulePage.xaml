<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Shiftlock.App.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 文面はここに書かない（コードから Core の文面を入れる）．色は標準のテーマ資源だけを使う． -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body" Padding="20,12,20,20" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="HintText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 今日から 28 日．7 日ずつ 4 行．1 日ぶんはボタンで，押すとその日の例外日を変える小窓が出る -->
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid x:Name="DaysGrid" ColumnSpacing="2" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </Border>

            <!-- 直前の操作の返事 -->
            <TextBlock
                x:Name="ResultText"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
